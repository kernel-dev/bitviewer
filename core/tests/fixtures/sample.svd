<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance">
  <name>DEMO</name>
  <description>Demo   chip &amp; friends</description>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>UART0</name>
      <groupName>UART</groupName>
      <baseAddress>0x40001000</baseAddress>
      <registers>
        <register>
          <name>CTRL</name>
          <description>Control register</description>
          <addressOffset>0x0</addressOffset>
          <resetValue>0x00000301</resetValue>
          <fields>
            <field>
              <name>EN</name>
              <description>Enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MODE</name>
              <bitRange>[9:8]</bitRange>
              <enumeratedValues>
                <name>ModeValues</name>
                <enumeratedValue><name>Off</name><value>0</value></enumeratedValue>
                <enumeratedValue><name>Auto</name><value>#1x</value></enumeratedValue>
                <enumeratedValue><name>Other</name><isDefault>true</isDefault></enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STATUS</name>
              <lsb>16</lsb><msb>19</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>CLASH</name>
              <lsb>8</lsb><msb>8</msb>
            </field>
            <field>
              <name>RESERVED</name>
              <bitRange>[31:28]</bitRange>
            </field>
            <field>
              <name>OUTSIDE</name>
              <bitOffset>40</bitOffset><bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <name>DATA%s</name>
          <addressOffset>0x10</addressOffset>
          <size>16</size>
          <access>read-only</access>
          <resetValue>0xFFFF</resetValue>
          <resetMask>0x00FF</resetMask>
        </register>
        <register>
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>A-C</dimIndex>
          <name>BUF[%s]</name>
          <addressOffset>0x20</addressOffset>
          <fields>
            <field>
              <name>BYTE%s</name>
              <dim>4</dim>
              <dimIncrement>8</dimIncrement>
              <bitOffset>0</bitOffset><bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register derivedFrom="CTRL">
          <name>CTRL2</name>
          <addressOffset>0x40</addressOffset>
        </register>
        <cluster>
          <dim>2</dim>
          <dimIncrement>0x10</dimIncrement>
          <name>CH%s</name>
          <addressOffset>0x100</addressOffset>
          <register>
            <name>CFG</name>
            <addressOffset>0x4</addressOffset>
            <fields>
              <field>
                <name>SPEED</name>
                <bitOffset>0</bitOffset><bitWidth>2</bitWidth>
                <enumeratedValues derivedFrom="ModeValues"/>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART1</name>
      <baseAddress>0x40002000</baseAddress>
    </peripheral>
    <peripheral>
      <name>WIDE</name>
      <baseAddress>0x50000000</baseAddress>
      <registers>
        <register><name>HUGE</name><addressOffset>0</addressOffset><size>1024</size></register>
      </registers>
    </peripheral>
  </peripherals>
</device>