@name C struct
@ext h
@about A union of the raw register and a bitfield struct. Wider registers become several words (see Register width).
/* ${name} — ${width}-bit register, generated by Bit Viewer.
 * Bitfield order is implementation-defined; this assumes the first member
 * is the least significant bit (GCC, Clang and MSVC on little-endian targets).
@if word_count > 1
 * Wider than ${platform} bits, so it is split into ${platform}-bit words, lowest first.
@end
 */
#ifndef ${prefix}_STRUCT_H
#define ${prefix}_STRUCT_H

#include <stdint.h>
@for word in words

@if word_count > 1
/* ${word.title}: bits [${word.hi}:${word.lo}] */
@end
typedef union {
  uint${word.storage}_t raw;
  struct {
@for item in word.items
    uint${word.storage}_t ${item.id | pad(name_width)} : ${item.width | padl(2)};  /* ${item.comment} */
@end
  } bits;
} ${prefix | lower}${word.suffix}_t;
@end
@if word_count > 1

typedef struct {
@for word in words
  ${prefix | lower}${word.suffix}_t ${word.member};
@end
} ${prefix | lower}_t;
@end
@if include_value
@for word in words
@set integer_suffix = "U"
@if word.storage > 32
@set integer_suffix = "ULL"
@end
@if loop.first

@end
#define ${prefix}_VALUE${word.suffix | upper} ${word.value}${integer_suffix}
@end
@end

#endif /* ${prefix}_STRUCT_H */
