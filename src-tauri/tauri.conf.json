{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bit Viewer",
  "mainBinaryName": "BitViewer",
  "version": "2.1.3",
  "identifier": "com.bitviewer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bit Viewer",
        "width": 1320,
        "height": 880,
        "minWidth": 780,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#09090b",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Inspect and edit values of 1 to 512 bits, bit by bit",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "bitview"
        ],
        "name": "Bit Viewer workspace",
        "description": "Bit Viewer workspace",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NEQ3RjRBQ0UzODg2MEYKUldRUGhqak9TbjlOVjJpVm1QZGx3aG0vSFpJdnF1Q2NaOHVlUHJLWitBQTAxdjJwQXZxLzl6VXMK",
      "endpoints": [
        "https://github.com/kernel-dev/bitviewer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
