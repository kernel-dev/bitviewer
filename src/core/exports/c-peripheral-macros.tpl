@name C peripheral addresses
@ext h
@scope peripheral
@about #defines for the base address and each register's offset and address, plus the current values when switched on.
/* ${name} — ${registers.length} registers, generated by Bit Viewer.
@if description
 * ${description}
@end
 */
#ifndef ${prefix}_ADDRESSES_H
#define ${prefix}_ADDRESSES_H

@set suffix = "UL"
@if address_bits > 32
@set suffix = "ULL"
@end
@if has_base
#define ${prefix}_BASE ${base}${suffix}

@end
@for register in registers
@set register_prefix = prefix + "_" + register.id
/* ${register.name}: ${register.width}-bit${register.description | lead(" ")} */
@if register.has_offset
#define ${register_prefix}_OFFSET ${register.offset}U
@if has_base
#define ${register_prefix}_ADDR   (${prefix}_BASE + ${register_prefix}_OFFSET)
@end
@else
/* no offset known */
@end
@if include_value and register.width <= 64
@set value_suffix = "U"
@if register.width > 32
@set value_suffix = "ULL"
@end
#define ${register_prefix}_VALUE  ${register.value}${value_suffix}
@end

@end
#endif /* ${prefix}_ADDRESSES_H */
