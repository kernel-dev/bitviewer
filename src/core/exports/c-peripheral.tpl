@name C peripheral struct
@ext h
@scope peripheral
@about A struct with every register at its offset (gaps padded), a pointer to the peripheral at its base address, and compile-time checks of each offset.
/* ${name} — ${registers.length} registers, generated by Bit Viewer.
@if description
 * ${description}
@end
@if has_base
 * Base address ${base}.
@end
 */
#ifndef ${prefix}_PERIPHERAL_H
#define ${prefix}_PERIPHERAL_H

#include <stddef.h>
#include <stdint.h>

typedef struct {
@for item in layout
@if item.gap
  uint8_t           ${item.declaration + ";" | pad(name_width + 1)}  /* ${item.range} unused */
@elif item.overlap
  /* ${item.id} at offset ${item.offset} overlaps the register before it, so it isn't a member */
@else
  volatile ${item.type | pad(8)} ${item.declaration + ";" | pad(name_width + 1)}  /* ${item.offset}${item.description | lead(" ")} */
@end
@end
} ${prefix | lower}_t;

@for item in layout
@if item.member
_Static_assert(offsetof(${prefix | lower}_t, ${item.id}) == ${item.offset}, "${item.id} is at offset ${item.offset}");
@end
@end
@if has_base
@set suffix = "UL"
@if address_bits > 32
@set suffix = "ULL"
@end

#define ${prefix}_BASE ${base}${suffix}
#define ${prefix} ((${prefix | lower}_t *)${prefix}_BASE)
@end
@if unplaced
/* Not in the struct because they have no offset: ${unplaced | join} */
@end

#endif /* ${prefix}_PERIPHERAL_H */
