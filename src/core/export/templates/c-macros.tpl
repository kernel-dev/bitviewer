@name C macros
@ext h
@about A header of #defines: each field's position, width and mask, plus GET / SET macros.
/* ${name} — ${width}-bit register, generated by Bit Viewer.
@if fields
 *
 * Layout:
@for field in fields | reverse
 *   ${field.range | pad(range_width)}  ${field.id | pad(name_width)}  ${field.note}
@end
@end
 *
 * <FIELD>_POS, _WIDTH and _MASK say where a field sits.
@if accessors
 * <FIELD>_GET(reg) reads it; <FIELD>_SET(reg, v) returns reg with it replaced.
@end
 */
#ifndef ${prefix}_REGS_H
#define ${prefix}_REGS_H

@if width > 64
/* C integer types stop at 64 bits; fields above bit 63 are listed as comments only. */

@end
@set integer_suffix = "U"
@set integer_cast = "(unsigned)"
@if width > 32
@set integer_suffix = "ULL"
@set integer_cast = "(unsigned long long)"
@end
@if has_address
@set address_suffix = "U"
@if address_bits > 32
@set address_suffix = "ULL"
@end
#define ${prefix}_ADDR ${address}${address_suffix}
@if not include_value or width > 64

@end
@end
@if include_value and width <= 64
#define ${prefix}_VALUE ${value}${integer_suffix}

@end
@for field in fields
@set field_prefix = prefix + "_" + field.id
/* ${field.name}: ${field.comment} */
@if field.hi > 63
/* ${field_prefix}: bits ${field.range} — not representable in a C integer */
@else
#define ${field_prefix}_POS   ${field.lo}U
#define ${field_prefix}_WIDTH ${field.width}U
#define ${field_prefix}_MASK  (${field.mask}${integer_suffix} << ${field_prefix}_POS)
@if accessors
#define ${field_prefix}_GET(reg)    (((reg) & ${field_prefix}_MASK) >> ${field_prefix}_POS)
#define ${field_prefix}_SET(reg, v) (((reg) & ~${field_prefix}_MASK) | ((${integer_cast}(v) << ${field_prefix}_POS) & ${field_prefix}_MASK))
@end
@for named_value in field.named
#define ${field_prefix}_${named_value.id} ${named_value.value}${integer_suffix}
@end
@end

@end
#endif /* ${prefix}_REGS_H */
