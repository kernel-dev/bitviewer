@name Rust peripheral
@ext rs
@scope peripheral
@about A module with the base address, each register's offset and a raw pointer to it.
/// ${name} — ${registers.length} registers, generated by Bit Viewer.
@if description
///
/// ${description}
@end
#[allow(dead_code)]
pub mod ${prefix | lower | rust_ident} {
@if has_base
    pub const BASE: usize = ${base};
@end
@for register in registers
@if register.has_offset

    /// ${register.name}${register.description | lead(" ")}
    pub const ${register.id}_OFFSET: usize = ${register.offset};
@if has_base
    pub const ${register.id}: *mut ${register.rust_type} = (BASE + ${register.id}_OFFSET) as *mut ${register.rust_type};
@end
@end
@end
}
