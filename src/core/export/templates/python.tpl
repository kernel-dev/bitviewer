@name Python
@ext py
@about Constants, plus a getter and a setter function for each field.
"""${name} — ${width}-bit register, generated by Bit Viewer.
@if fields

Layout:
@for field in fields | reverse
  ${field.range | pad(range_width)}  ${field.id | pad(name_width)}  ${field.note}
@end
@end
"""

@if has_address
${prefix}_ADDR = ${address}
@if not include_value

@end
@end
@if include_value
${prefix}_VALUE = ${value}

@end
@for field in fields
@set field_prefix = prefix + "_" + field.id
@set function_name = field_prefix | lower
# ${field.name}: ${field.comment}
${field_prefix}_SHIFT = ${field.lo}
${field_prefix}_MASK = ${field.shifted_mask}
@for named_value in field.named
${field_prefix}_${named_value.id} = ${named_value.value}
@end
@if accessors


def ${function_name}(reg):
    return (reg & ${field_prefix}_MASK) >> ${field_prefix}_SHIFT


def set_${function_name}(reg, value):
    return (reg & ~${field_prefix}_MASK) | ((value << ${field_prefix}_SHIFT) & ${field_prefix}_MASK)
@end

@end
