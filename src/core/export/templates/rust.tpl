@name Rust
@ext rs
@about A module of constants, plus const fn getters and setters for each field.
@if width > 128
// Rust integers stop at 128 bits (this value has ${width}).
@else
/// ${name} — ${width}-bit register, generated by Bit Viewer.
@if fields
///
/// Layout:
@for field in fields | reverse
///   ${field.range | pad(range_width)}  ${field.id | pad(name_width)}  ${field.note}
@end
@end
pub mod ${prefix | lower | rust_ident} {
@set integer_type = "u" + uint_bits
@if has_address
    pub const ADDR: usize = ${address};
@if fields and not include_value

@end
@end
@if include_value
    pub const VALUE: ${integer_type} = ${value};
@if fields

@end
@end
@for field in fields
    /// ${field.name}: ${field.comment}
    pub const ${field.id}_SHIFT: u32 = ${field.lo};
    pub const ${field.id}_MASK: ${integer_type} = ${field.shifted_mask};
@if accessors
    pub const fn ${field.id | lower | rust_ident}(reg: ${integer_type}) -> ${integer_type} {
        (reg & ${field.id}_MASK) >> ${field.id}_SHIFT
    }
    pub const fn set_${field.id | lower}(reg: ${integer_type}, v: ${integer_type}) -> ${integer_type} {
        (reg & !${field.id}_MASK) | ((v << ${field.id}_SHIFT) & ${field.id}_MASK)
    }
@end
@for named_value in field.named
    pub const ${field.id}_${named_value.id}: ${integer_type} = ${named_value.value};
@end
@if not loop.last

@end
@end
}
@end
