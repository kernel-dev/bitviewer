{
  "name": "bitviewer",
  "private": true,
  "version": "2.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "lint": "biome check . && cd src-tauri && cargo clippy --quiet --all-targets -- -D warnings",
    "format": "biome check --write . && cd src-tauri && cargo fmt",
    "check": "tsc --noEmit && biome check . && vitest run && cd src-tauri && cargo fmt --check && cargo clippy --quiet --all-targets -- -D warnings && cargo test --quiet",
    "release": "node scripts/release.mjs",
    "test:e2e": "playwright test",
    "docs:shots": "playwright test --config playwright.docs.config.ts",
    "bench": "node bench/run.mjs && node bench/report.mjs",
    "bench:report": "node bench/report.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide": "^1.59.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
